# Copy to .env for local configuration. Never commit a real .env file.
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
WEBSHIELD_DB=webshield.db
WEBSHIELD_MAX_LINKS=30
WEBSHIELD_TIMEOUT=6
WEBSHIELD_MAX_RESPONSE_BYTES=1500000
LOG_LEVEL=INFO
# Set only when deployed behind a trusted reverse proxy you control:
TRUST_PROXY=0
# For multi-worker deployments, configure a shared Redis instance:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
